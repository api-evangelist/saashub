          "name": "Get Product by Name",
          "request": {
            "name": "Get Product by Name",
            "description": {
              "content": "Returns data for the first software product matching the query string. Returns product details including name, tagline, SaaSHub URL, pricing, categories, and basic metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "product",
                ":query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your SaaSHub API key. Obtain from https://www.saashub.com/profile/api_key"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "query",
                  "description": "(Required) Product name to search for (e.g., \"basecamp\", \"slack\", \"notion\"). URL-encode spaces and special characters."
                }
              ]
            },
